<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the notification-area icon and the colour dialog. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UFO</AssemblyName>
    <RootNamespace>Ufo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>ufo.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent dark) is still flagged experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- WFO0003 asks WinForms apps to set DPI in code; this is a WPF app, where the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="ufo.ico" />
  </ItemGroup>

  <!-- Windows Forms is referenced by full name; its implicit usings would clash with WPF types. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- M274 files travel in an "m274" folder beside the app: the native DLL (built from
       C:\UFO\m274) and the elevated installer. -->
  <ItemGroup>
    <None Include="..\..\m274\build\M274.dll" Link="m274\M274.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\m274\build\M274.dll')" />
    <ProjectReference Include="..\Ufo.M274Ctl\Ufo.M274Ctl.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyM274Ctl" AfterTargets="Build">
    <ItemGroup>
      <M274CtlFiles Include="..\Ufo.M274Ctl\bin\$(Configuration)\net10.0-windows\m274ctl.*" />
    </ItemGroup>
    <Copy SourceFiles="@(M274CtlFiles)" DestinationFolder="$(OutDir)m274" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishM274Ctl" AfterTargets="Publish">
    <ItemGroup>
      <M274CtlPublishFiles Include="..\Ufo.M274Ctl\bin\$(Configuration)\net10.0-windows\m274ctl.*" />
    </ItemGroup>
    <Copy SourceFiles="@(M274CtlPublishFiles)" DestinationFolder="$(PublishDir)m274" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Ufo.Device\Ufo.Device.csproj" />
    <ProjectReference Include="..\Ufo.Audio\Ufo.Audio.csproj" />
    <ProjectReference Include="..\Ufo.Clips\Ufo.Clips.csproj" />
  </ItemGroup>

  <!-- Clips: ffmpeg travels in an "ffmpeg" folder beside the app when tools\ffmpeg\ffmpeg.exe exists
       (not in git); without it the one on PATH is used. -->
  <ItemGroup>
    <None Include="..\..\tools\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\tools\ffmpeg\ffmpeg.exe')" />
  </ItemGroup>

</Project>
