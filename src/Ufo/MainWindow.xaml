<Window x:Class="Ufo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:device="clr-namespace:Ufo.Device;assembly=Ufo.Device"
        Title="UFO" Icon="ufo.ico" Width="1120" Height="780" MinWidth="720" MinHeight="520"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource TextFont}"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="OnWindowStateChanged"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Own title bar: the whole strip drags the window; only the buttons take clicks. -->
        <Grid Background="{DynamicResource BgBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ContentControl Style="{StaticResource UfoIcon}" Width="22" Margin="0,0,10,0" />
                <TextBlock Text="ufo" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SettingsButton" Style="{StaticResource CaptionButton}" Content="&#xE713;" FontSize="12" ToolTip="Configurações"
                        AutomationProperties.Name="Configurações" Click="OnSettingsClick" RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform><RotateTransform x:Name="SettingsGearTurn" /></Button.RenderTransform>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar" Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar" Click="OnMaximizeClick" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Fechar" Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Shell" Grid.Row="1">
            <!-- Whole interface scales with the window (see OnRootSizeChanged); layout still reflows. -->
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ShellScale" />
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="360" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- Orbit: the three sections are moons around the saucer; the ring turns the open one to the front.
                 Moon labels sit on a page-coloured plate so the dashed ring passes behind them, not through them. -->
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Width="310" Height="310">
                    <Ellipse Stroke="{DynamicResource RingBrush}" StrokeThickness="1" StrokeDashArray="3 3" />
                    <Canvas Width="310" Height="310" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="RingRotation" />
                        </Canvas.RenderTransform>
                        <Grid x:Name="FoneMoon" Canvas.Left="260" Canvas.Top="105" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                            <RadioButton x:Name="FoneMoonButton" GroupName="Section" Style="{StaticResource Moon}" AutomationProperties.Name="Fone" Tag="fone" IsChecked="True" Checked="OnSectionChecked"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Fone">
                                <TextBlock Text="&#xE7F6;" FontFamily="Segoe Fluent Icons" FontSize="20" />
                            </RadioButton>
                            <TextBlock Text="fone" Style="{StaticResource Kicker}" Margin="0" Padding="6,0" Background="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid x:Name="MicMoon" Canvas.Left="27.5" Canvas.Top="239.2" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                            <RadioButton x:Name="MicMoonButton" GroupName="Section" Style="{StaticResource Moon}" AutomationProperties.Name="Microfone" Tag="mic" Checked="OnSectionChecked"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Microfone">
                                <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons" FontSize="20" />
                            </RadioButton>
                            <TextBlock Text="microfone" Style="{StaticResource Kicker}" Margin="0" Padding="6,0" Background="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                        <Grid x:Name="EqMoon" Canvas.Left="27.5" Canvas.Top="-29.2" Width="100" Height="100" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform /></Grid.RenderTransform>
                            <RadioButton x:Name="EqMoonButton" GroupName="Section" Style="{StaticResource Moon}" AutomationProperties.Name="Equalizador" Tag="eq" Checked="OnSectionChecked"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Equalizador">
                                <TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons" FontSize="20" />
                            </RadioButton>
                            <TextBlock Text="equalizador" Style="{StaticResource Kicker}" Margin="0" Padding="6,0" Background="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                    </Canvas>
                    <!-- Lifted 16 px so the readout clears the lower moon. -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-16,0,0">
                        <Grid>
                        <!-- Headset offline: the saucer is lodged on its edge in the ground, lights dead but for a failing
                             flicker, shorting out, the beam trying to light (see ShowCrash). Same scale as the flying
                             one (200 units = 118 px). -->
                        <Viewbox x:Name="CrashedUfo" Width="177" VerticalAlignment="Bottom" Visibility="Collapsed">
                            <Canvas Width="300" Height="190">
                                <Rectangle Canvas.Top="172" Width="300" Height="1.5" Fill="{DynamicResource RingBrush}" />
                                <!-- Clipped at the ground line; open above and to the sides for the slam-in. -->
                                <Canvas>
                                    <Canvas.Clip><RectangleGeometry Rect="-60,-80,420,252" /></Canvas.Clip>
                                    <Canvas x:Name="CrashSlam">
                                        <Canvas.RenderTransform><TranslateTransform x:Name="CrashSlamShift" /></Canvas.RenderTransform>
                                        <Canvas Canvas.Left="50" Canvas.Top="88" Width="200" Height="92">
                                            <Canvas.RenderTransform><RotateTransform Angle="-58" CenterX="100" CenterY="52" /></Canvas.RenderTransform>
                                            <Path x:Name="CrashBeam" Data="M74,82 H126 L142,132 H58 Z" Fill="{DynamicResource AccentBrush}" Opacity="0" />
                                            <ContentControl x:Name="CrashedSaucer" Style="{StaticResource UfoIcon}" Width="200" />
                                            <!-- Scratches on the hull and a crack on the dome. -->
                                            <Path Data="M118,33 l15,7 M127,30 l10,5 M150,42 l13,4 M86,35 l-10,6 M160,50 l9,1 M106,10 l5,6 l-3,5"
                                                  Stroke="{DynamicResource BgBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Path x:Name="CrashSparkTop" Data="M172,40 l8,-9 l-1,7 l8,-5" Opacity="0"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                            <Path x:Name="CrashSparkBelly" Data="M146,74 l7,8 l1,-7 l7,7" Opacity="0"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Canvas>
                                </Canvas>
                                <!-- Earth thrown up around the buried edge. -->
                                <Canvas x:Name="CrashDebris">
                                    <Canvas.RenderTransform><ScaleTransform x:Name="CrashDebrisScale" CenterX="144" CenterY="173.5" /></Canvas.RenderTransform>
                                    <Path Data="M92,173.5 C100,160 116,150 134,152 C150,153 160,160 168,164 C178,168 188,173.5 196,173.5 Z" Fill="{DynamicResource RingBrush}" />
                                    <Ellipse Canvas.Left="72.8" Canvas.Top="168.2" Width="6.4" Height="4.4" Fill="{DynamicResource RingBrush}" />
                                    <Ellipse Canvas.Left="58" Canvas.Top="169.6" Width="4" Height="2.8" Fill="{DynamicResource RingBrush}" />
                                    <Ellipse Canvas.Left="39.6" Canvas.Top="170.3" Width="2.8" Height="2" Fill="{DynamicResource RingBrush}" />
                                    <Ellipse Canvas.Left="209.4" Canvas.Top="168.8" Width="5.2" Height="3.6" Fill="{DynamicResource RingBrush}" />
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                        <!-- Saucer and battery beam float together (see StartFloating). -->
                        <StackPanel x:Name="FlyingUfo">
                            <StackPanel.RenderTransform><TranslateTransform x:Name="UfoFloat" /></StackPanel.RenderTransform>
                            <ContentControl Style="{StaticResource UfoIcon}" Width="118" Panel.ZIndex="1" />
                            <!-- Battery as a tractor beam: same 200-unit artboard as the saucer, so it leaves the
                                 hatch exactly. Flat charge cut by page-coloured gaps that drift (see MainWindow.Battery.cs). -->
                            <Viewbox Width="118" Margin="0,-7.7,0,0">
                                <Canvas Width="200" Height="150">
                                    <Canvas.Clip>
                                        <PathGeometry Figures="M72,0 H128 L176,150 H24 Z" />
                                    </Canvas.Clip>
                                    <Rectangle Width="200" Height="150" Fill="{DynamicResource SurfaceBrush}" />
                                    <Canvas x:Name="BeamLevel" Width="200" Height="150">
                                        <Canvas.Clip>
                                            <RectangleGeometry x:Name="BeamLevelClip" Rect="0,150,200,0" />
                                        </Canvas.Clip>
                                        <Canvas.RenderTransform>
                                            <ScaleTransform x:Name="BeamLevelScale" CenterY="150" />
                                        </Canvas.RenderTransform>
                                        <Rectangle x:Name="BeamCharge" Width="200" Height="150" Fill="{DynamicResource AccentBrush}" />
                                        <Canvas x:Name="BeamGaps">
                                            <Canvas.RenderTransform>
                                                <TranslateTransform x:Name="BeamGapsShift" />
                                            </Canvas.RenderTransform>
                                        </Canvas>
                                    </Canvas>
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                        </Grid>
                        <TextBlock x:Name="BatteryText" FontFamily="{StaticResource MonoFont}" FontSize="28" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   AutomationProperties.Name="Bateria" />
                        <TextBlock x:Name="LinkText" Style="{StaticResource Kicker}" Margin="0" HorizontalAlignment="Center" Text="procurando o dongle…" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content rail: every panel and the save bar share one column, up to 760 px wide, left-aligned. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="56,48,56,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="760" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ContentRail" SizeChanged="OnContentRailSizeChanged">
                <Grid x:Name="Panels">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="PanelsShift" />
                    </Grid.RenderTransform>

                    <!-- Fone: device strip on top, then the two setting groups (side by side when there is room). -->
                    <StackPanel x:Name="FonePanel" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,6,12,0" />
                            <TextBlock Text="fone" Style="{StaticResource PanelTitle}" />
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="0.6*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Aparelho" Style="{StaticResource Kicker}" />
                                    <TextBlock Text="AW Pro Wireless" FontSize="15" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Conexão" Style="{StaticResource Kicker}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{DynamicResource MutedBrush}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="ConnectionText" Text="procurando…" FontSize="15" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Firmware" Style="{StaticResource Kicker}" />
                                    <TextBlock x:Name="FirmwareText" FontSize="15" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Bateria" Style="{StaticResource Kicker}" />
                                    <TextBlock FontSize="15" Text="{Binding Text, ElementName=BatteryText}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid x:Name="FoneColumns">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="Som ambiente" Style="{StaticResource SectionHeading}" />
                                    <WrapPanel>
                                        <RadioButton x:Name="ModeOff" GroupName="SoundMode" Style="{StaticResource SegOption}" Content="Desligado"
                                                     Tag="{x:Static device:SoundMode.Off}" Checked="OnSoundModeChecked" />
                                        <RadioButton x:Name="ModeAnc" GroupName="SoundMode" Style="{StaticResource SegOption}" Content="ANC"
                                                     Tag="{x:Static device:SoundMode.NoiseCancelling}" Checked="OnSoundModeChecked" />
                                        <RadioButton x:Name="ModeTransparency" GroupName="SoundMode" Style="{StaticResource SegOption}" Content="Transparência"
                                                     Tag="{x:Static device:SoundMode.Transparency}" Checked="OnSoundModeChecked" />
                                    </WrapPanel>
                                    <Grid Margin="0,16,0,0" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Intensidade" Style="{StaticResource Hint}" />
                                        <Slider x:Name="AncLevelSlider" Grid.Column="1" Minimum="1" Maximum="5" Value="3" AutomationProperties.Name="Intensidade"
                                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnAncLevelChanged" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=AncLevelSlider}" />
                                    </Grid>
                                    <TextBlock Text="Vale para o ANC e para a transparência." Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="FoneSecondGroup" Grid.Column="2" Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="Energia" Style="{StaticResource SectionHeading}" Margin="0" />
                                    <CheckBox x:Name="SleepCheck" Style="{StaticResource Switch}" Click="OnSleepChanged" AutomationProperties.Name="Desligar quando ocioso">
                                        <StackPanel>
                                            <TextBlock Text="Desligar quando ocioso" />
                                            <TextBlock Text="Economiza bateria quando você tira o fone." Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <WrapPanel x:Name="SleepMinutesPanel" Margin="0,0,0,8" IsEnabled="{Binding IsChecked, ElementName=SleepCheck}">
                                        <RadioButton GroupName="SleepMinutes" Style="{StaticResource SegOption}" FontSize="15" Margin="0,0,20,8" Content="15 min" Tag="15" Checked="OnSleepChanged" />
                                        <RadioButton GroupName="SleepMinutes" Style="{StaticResource SegOption}" FontSize="15" Margin="0,0,20,8" Content="30 min" Tag="30" Checked="OnSleepChanged" />
                                        <RadioButton GroupName="SleepMinutes" Style="{StaticResource SegOption}" FontSize="15" Margin="0,0,20,8" Content="45 min" Tag="45" Checked="OnSleepChanged" />
                                        <RadioButton GroupName="SleepMinutes" Style="{StaticResource SegOption}" FontSize="15" Margin="0,0,20,8" Content="60 min" Tag="60" Checked="OnSleepChanged" />
                                    </WrapPanel>
                                    <CheckBox x:Name="EnduranceCheck" Style="{StaticResource Switch}" Click="OnEnduranceClick" AutomationProperties.Name="Modo economia">
                                        <StackPanel>
                                            <TextBlock Text="Modo economia" />
                                            <TextBlock Text="Reduz o consumo quando a bateria fica baixa." Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Grid MinHeight="44" IsEnabled="{Binding IsChecked, ElementName=EnduranceCheck}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ativar abaixo de" Style="{StaticResource Hint}" />
                                        <Slider x:Name="EnduranceSlider" Grid.Column="1" Minimum="5" Maximum="100" Value="20" AutomationProperties.Name="Ativar abaixo de"
                                                IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="OnEnduranceThresholdChanged" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=EnduranceSlider, StringFormat={}{0}%}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Microfone: capture and voice return, side by side when there is room, rows aligned at 44 px. -->
                    <StackPanel x:Name="MicPanel" IsEnabled="False" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,6,12,0" />
                            <TextBlock Text="microfone" Style="{StaticResource PanelTitle}" />
                        </StackPanel>
                        <Grid x:Name="MicColumns">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="Captação" Style="{StaticResource SectionHeading}" Margin="0" />
                                    <CheckBox x:Name="MicEnabledCheck" Style="{StaticResource Switch}" Content="Microfone ativo" Click="OnMicEnabledClick" AutomationProperties.Name="Microfone ativo" />
                                    <CheckBox x:Name="NoiseReductionCheck" Style="{StaticResource Switch}" Click="OnNoiseReductionClick" AutomationProperties.Name="Redução de ruído por IA"
                                              IsEnabled="{Binding IsChecked, ElementName=MicEnabledCheck}">
                                        <StackPanel>
                                            <TextBlock Text="Redução de ruído por IA" />
                                            <TextBlock Text="Processada dentro do próprio fone." Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Grid MinHeight="44">
                                        <TextBlock Text="Microfone removível" Style="{StaticResource Hint}" />
                                        <TextBlock x:Name="BoomMicText" FontSize="14" Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MicSecondGroup" Grid.Column="2" Style="{StaticResource Section}">
                                <StackPanel IsEnabled="{Binding IsChecked, ElementName=MicEnabledCheck}">
                                    <TextBlock Text="Retorno da voz" Style="{StaticResource SectionHeading}" Margin="0" />
                                    <Grid MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Sidetone" Style="{StaticResource Hint}" />
                                        <Slider x:Name="SidetoneSlider" Grid.Column="1" Minimum="0" Maximum="5" AutomationProperties.Name="Sidetone"
                                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnSidetoneChanged" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=SidetoneSlider}" />
                                    </Grid>
                                    <TextBlock Text="Quanto da sua voz você ouve no fone enquanto fala." Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- Voice processing done by the M274 on the PC (rows generated in MainWindow.Voice.cs).
                             Lives outside the headset-only groups: it works on what Windows receives. -->
                        <Border Style="{StaticResource Section}" IsEnabled="True">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Processamento de voz" Style="{StaticResource SectionHeading}" />
                                    <CheckBox x:Name="VoiceEnabledCheck" Grid.Column="1" Style="{StaticResource Switch}" Padding="0" Click="OnVoiceEnabledClick"
                                              AutomationProperties.Name="Processamento de voz ativo" VerticalAlignment="Top"
                                              ToolTip="Trata a sua voz no PC, depois do fone. Vale para qualquer programa: Discord, Teams, jogos.">
                                        <TextBlock Text="Ativo" FontSize="14" />
                                    </CheckBox>
                                </Grid>
                                <TextBlock x:Name="VoiceInfoText" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <WrapPanel x:Name="VoiceStylePanel" Margin="0,0,0,8" />
                                <StackPanel x:Name="VoiceRows" />
                                <StackPanel Margin="0,12,0,0">
                                <Button x:Name="VoiceAdvancedButton" Style="{StaticResource QuietButton}" Height="36" HorizontalAlignment="Left" Content="Mostrar ajustes avançados" Click="OnAdvancedClick"
                                    ToolTip="Redução de ruído, compressor, nivelador, de-esser e timbre da voz, um por um." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="MicTestButton" Style="{StaticResource PrimaryButton}" Content="Gravar 5 s e ouvir" Click="OnMicTestClick"
                                            ToolTip="Grava sua voz por 5 segundos e toca no fone, para ouvir como os outros ouvem você." />
                                    <TextBlock x:Name="MicTestText" Style="{StaticResource Hint}" FontSize="13" Margin="16,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Configurações: colour engine and app behaviour, opened by the gear in the title bar.
                         Saved as soon as they change, so the save bar hides here. -->
                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                        <Grid Margin="0,0,0,32">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,6,12,0" />
                                <TextBlock Text="configurações" Style="{StaticResource PanelTitle}" />
                            </StackPanel>
                            <Button Style="{StaticResource QuietButton}" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Voltar" Click="OnSettingsBackClick" />
                        </Grid>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="Cor de destaque" Style="{StaticResource SectionHeading}" />
                                <WrapPanel x:Name="AccentPanel">
                                    <Button x:Name="CustomAccentButton" Width="44" Height="44" Margin="0,0,12,12" Cursor="Hand" ToolTip="Escolher outra cor"
                                            FocusVisualStyle="{StaticResource FocusRingRound}" Click="OnCustomAccentClick" AutomationProperties.Name="Escolher outra cor">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="Edge" Margin="5" Stroke="{DynamicResource MutedBrush}" StrokeDashArray="3 3" />
                                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Edge" Property="Stroke" Value="{DynamicResource InkBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="Fundo" Style="{StaticResource SectionHeading}" />
                                <WrapPanel x:Name="ThemePanel" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="Motor de áudio" Style="{StaticResource SectionHeading}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="EngineStateText" FontSize="16" />
                                        <TextBlock Text="Aplica o equalizador ao som do fone. Instalar e remover pedem permissão de administrador e reiniciam o áudio do Windows por um instante; remover devolve a configuração original."
                                                   Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="EngineProgress" IsIndeterminate="True" Height="2" Margin="0,10,0,0" Visibility="Collapsed"
                                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0" />
                                    </StackPanel>
                                    <Button x:Name="RemoveEngineButton" Grid.Column="1" Style="{StaticResource QuietButton}" Height="36" Margin="0,0,8,0" Content="Remover" Click="OnRemoveEngineClick" VerticalAlignment="Center" />
                                    <Button x:Name="InstallEngineButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Instalar motor" Click="OnInstallEngineClick" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="Verificação" Style="{StaticResource SectionHeading}" />
                                <TextBlock Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap"
                                           Text="Confere fone, saída, motor e microfone e diz o que consertar. Só roda quando você pede: toca um tom curto no fone e ouve o microfone por alguns segundos. Nada é gravado em disco." />
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="CheckAudioOption" Style="{StaticResource Switch}" Padding="0" Margin="0,0,32,0" MinHeight="44" IsChecked="True"
                                              AutomationProperties.Name="Verificar áudio" ToolTip="Saída do Windows, formato, volume e se o motor está de fato processando o som.">
                                        <TextBlock Text="Áudio" FontSize="14" />
                                    </CheckBox>
                                    <CheckBox x:Name="CheckMicrophoneOption" Style="{StaticResource Switch}" Padding="0" Margin="0,0,32,0" MinHeight="44" IsChecked="True"
                                              AutomationProperties.Name="Verificar microfone" ToolTip="Entrada do Windows, qualidade do link, ruído de fundo e nível da sua voz. Pede silêncio e depois que você fale.">
                                        <TextBlock Text="Microfone" FontSize="14" />
                                    </CheckBox>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="VerifyButton" Style="{StaticResource PrimaryButton}" Content="Verificar" Click="OnVerifyClick" />
                                    <TextBlock x:Name="VerifyStepText" FontSize="14" Margin="16,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="CheckResults" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="Comportamento" Style="{StaticResource SectionHeading}" Margin="0" />
                                <CheckBox x:Name="StartWithWindowsCheck" AutomationProperties.Name="Iniciar com o Windows" Style="{StaticResource Switch}" Checked="OnStartWithWindowsChanged" Unchecked="OnStartWithWindowsChanged">
                                    <StackPanel>
                                        <TextBlock Text="Iniciar com o Windows" />
                                        <TextBlock Text="Abre sozinho quando você liga o PC, sem aparecer na sua frente." Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="RunInBackgroundCheck" AutomationProperties.Name="Continuar em segundo plano" Style="{StaticResource Switch}" Checked="OnRunInBackgroundChanged" Unchecked="OnRunInBackgroundChanged">
                                    <StackPanel>
                                        <TextBlock Text="Continuar em segundo plano" />
                                        <TextBlock Text="Ao fechar a janela, o UFO fica no ícone da bandeja. Para sair de vez, clique com o botão direito no ícone e escolha Fechar."
                                                   Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Equalizador: profiles, the parametric curve over a live spectrum, sound extras and the
                         ear calibration. Rows of sliders are generated in code (MainWindow.Sound.cs). -->
                    <StackPanel x:Name="EqPanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,32">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Margin="0,6,12,0" />
                            <TextBlock Text="equalizador" Style="{StaticResource PanelTitle}" />
                        </StackPanel>
                        <Grid>
                        <StackPanel x:Name="EqContent">
                            <StackPanel.Effect>
                                <BlurEffect x:Name="EqBlur" Radius="0" />
                            </StackPanel.Effect>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Perfil" Style="{StaticResource SectionHeading}"
                                                   ToolTip="Cada perfil guarda a própria curva e os ajustes de Som. Trocar de perfil troca tudo de uma vez." />
                                        <CheckBox x:Name="AutoProfileCheck" Grid.Column="1" Style="{StaticResource Switch}" Padding="0" Click="OnAutoProfileClick" VerticalAlignment="Top"
                                                  AutomationProperties.Name="Troca automática de perfil"
                                                  ToolTip="Troca de perfil sozinho: jogo em tela cheia → Jogo; vídeo em tela cheia → Filme; player de música tocando → Música; senão volta ao perfil que você escolheu. Escolher um perfil na mão vale até a situação mudar.">
                                            <TextBlock Text="Automático" FontSize="14" />
                                        </CheckBox>
                                    </Grid>
                                    <WrapPanel x:Name="EqProfilePanel" />
                                    <Grid x:Name="ProfileAppsRow" Margin="0,8,0,0" MinHeight="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ativar sozinho com" Style="{StaticResource Hint}" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   ToolTip="Programas que ativam este perfil quando estão na frente ou tocando som. Só vale com Automático ligado." />
                                        <TextBox x:Name="ProfileAppsBox" Grid.Column="1" FontSize="13" Padding="8,6" LostFocus="OnProfileAppsChanged"
                                                 Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                 CaretBrush="{DynamicResource InkBrush}" AutomationProperties.Name="Programas que ativam este perfil"
                                                 ToolTip="Nomes dos programas (o nome do .exe, sem .exe), separados por vírgula. Exemplo: spotify, valorant, vlc" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="RecommendedButton" Style="{StaticResource QuietButton}" Height="32" Content="Usar ajuste recomendado" Click="OnRecommendedClick"
                                                ToolTip="Repõe neste perfil a curva e os ajustes de Som pensados para ele. A calibração de ouvido é mantida." />
                                        <TextBlock x:Name="AutoProfileText" Style="{StaticResource Hint}" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Som" Style="{StaticResource SectionHeading}" />
                                        <Button x:Name="CompareButton" Grid.Column="1" Style="{StaticResource QuietButton}" Height="28" Margin="0,0,16,0" Content="Segure para comparar" VerticalAlignment="Top"
                                                PreviewMouseLeftButtonDown="OnCompareDown" PreviewMouseLeftButtonUp="OnCompareUp" MouseLeave="OnCompareLeave"
                                                ToolTip="Enquanto segura, ouve o som sem o equalizador, no mesmo volume" />
                                        <CheckBox x:Name="EqEnabledCheck" Grid.Column="2" Style="{StaticResource Switch}" Padding="0" Click="OnEqEnabledClick" AutomationProperties.Name="Equalizador ativo"
                                                  ToolTip="Desligado, o fone toca sem nenhum processamento deste perfil: nem curva, nem os ajustes de Som."
                                                  VerticalAlignment="Top">
                                            <TextBlock Text="Ativo" FontSize="14" />
                                        </CheckBox>
                                    </Grid>
                                    <WrapPanel x:Name="EqPresetPanel" />
                                    <!-- Drag a point: frequency and gain. Wheel: width. Double-click: add. Right-click: remove. -->
                                    <Canvas x:Name="EqCurveCanvas" Height="220" Margin="0,12,0,8" ClipToBounds="True" Background="Transparent" SizeChanged="OnEqCurveResized"
                                            MouseLeftButtonDown="OnCurveMouseDown" MouseMove="OnCurveMouseMove" MouseLeftButtonUp="OnCurveMouseUp"
                                            MouseRightButtonDown="OnCurveRightClick" MouseWheel="OnCurveWheel" MouseLeave="OnCurveMouseLeave">
                                        <Polygon x:Name="EqSpectrum" Fill="{DynamicResource SurfaceBrush}" />
                                        <Line x:Name="EqZeroLine" Stroke="{DynamicResource LineBrush}" StrokeThickness="1" />
                                        <Polygon x:Name="EqCurveFill" Fill="{DynamicResource AccentWashBrush}" />
                                        <Polyline x:Name="EqCurveLine" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
                                        <Canvas x:Name="EqPoints" />
                                    </Canvas>
                                    <Grid x:Name="BandDetailRow" MinHeight="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BandDetailText" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap"
                                                   Text="Arraste um ponto para mudar frequência e ganho. Roda do mouse: largura. Duplo clique: novo ponto. Botão direito: remover." />
                                        <WrapPanel x:Name="BandKindPanel" Grid.Column="1" Visibility="Collapsed" Margin="16,0,0,0" />
                                    </Grid>
                                    <UniformGrid x:Name="EqBandsGrid" Columns="10" Margin="0,8,0,0" />
                                    <!-- The two controls most people need; the rest lives under "ajustes avançados". -->
                                    <StackPanel x:Name="QuickSoundRows" />
                                    <!-- Listens to a playlist and proposes the settings that balance it (MainWindow.Analysis.cs). -->
                                    <WrapPanel Margin="0,16,0,0">
                                        <Button x:Name="AnalyzeButton" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Content="Analisar o que está tocando" Click="OnAnalyzeClick"
                                                ToolTip="Escolha o perfil, dê play numa playlist (Spotify ou qualquer player) e clique. O UFO ouve por pelo menos 30 segundos e propõe curva, volume e modo Noite para ela." />
                                        <Button x:Name="AnalysisCancelButton" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Visibility="Collapsed" Content="Cancelar" Click="OnAnalysisCancelClick" />
                                    </WrapPanel>
                                    <TextBlock x:Name="AnalysisText" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="EqEngineText" Style="{StaticResource Hint}" FontSize="13" Margin="0,16,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,24">
                                <Button x:Name="AdvancedButton" Style="{StaticResource QuietButton}" Height="36" HorizontalAlignment="Left" Content="Mostrar ajustes avançados" Click="OnAdvancedClick"
                                    ToolTip="Curva por pontos, programas de cada perfil, crossfeed, passos, modo noite, proteções e calibração de ouvido." />
                            </StackPanel>
                            <Border x:Name="SoundAdvanced" Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="Ajuste fino" Style="{StaticResource SectionHeading}" />
                                    <StackPanel x:Name="SoundRows" />
                                </StackPanel>
                            </Border>

                            <Border x:Name="CalibrationAdvanced" Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock Text="Calibração de ouvido" Style="{StaticResource SectionHeading}" />
                                    <TextBlock x:Name="CalibrationText" Style="{StaticResource Hint}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <Grid x:Name="CalibrationStep" Visibility="Collapsed" MinHeight="44" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CalibrationToneText" Style="{StaticResource Hint}" />
                                        <Slider x:Name="CalibrationSlider" Grid.Column="1" Minimum="-18" Maximum="24" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                ValueChanged="OnCalibrationLevelChanged" AutomationProperties.Name="Volume do tom de teste" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value, ElementName=CalibrationSlider, StringFormat={}{0:+0.0;-0.0;0} dB}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CalibrationButton" Style="{StaticResource PrimaryButton}" Content="Calibrar" Click="OnCalibrationClick"
                                                ToolTip="Você iguala o volume de oito tons a um tom de referência; o UFO corrige o fone para o seu ouvido." />
                                        <Button x:Name="CalibrationCancelButton" Style="{StaticResource QuietButton}" Height="36" Margin="8,0,0,0" Visibility="Collapsed" Content="Cancelar" Click="OnCalibrationCancelClick" />
                                        <Button x:Name="CalibrationClearButton" Style="{StaticResource QuietButton}" Height="36" Margin="8,0,0,0" Visibility="Collapsed" Content="Apagar calibração" Click="OnCalibrationClearClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- Without the engine the equalizer cannot change the sound: the controls blur and
                             lock, and the install action sits right here instead of hiding in settings. -->
                        <StackPanel x:Name="EqInstallGate" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,120,0,0" MaxWidth="420">
                            <TextBlock x:Name="EqGateTitle" Text="O equalizador precisa do motor de áudio" FontSize="18" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="EqGateText" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20"
                                       Text="É ele que aplica a curva ao som do fone. A instalação pede permissão de administrador e reinicia o áudio do Windows por um instante." />
                            <Button x:Name="EqGateInstallButton" Style="{StaticResource PrimaryButton}" Content="Instalar motor" Click="OnInstallEngineClick" HorizontalAlignment="Center" />
                            <ProgressBar x:Name="EqGateProgress" IsIndeterminate="True" Height="2" Width="220" Margin="0,16,0,0" Visibility="Collapsed"
                                         Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource LineBrush}" BorderThickness="0" />
                        </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Save bar: right under the content it saves. Errors on the left, state and "Salvar" on the right. -->
                <Border x:Name="SaveBar" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Foreground="{DynamicResource ErrorBrush}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock x:Name="SaveStateText" Grid.Column="1" Style="{StaticResource Kicker}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <Button x:Name="SaveButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Salvar" Click="OnSaveClick"
                                ToolTip="Guarda fone, microfone e equalizador; reaplicados ao abrir o app e quando o fone reconecta" />
                    </Grid>
                </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Splash: a green plain with a grass tuft, the UFO-calligram cow nibbling it, then the abduction. Click skips. -->
        <Grid x:Name="SplashOverlay" Grid.Row="1" Background="Black" Cursor="Hand" MouseLeftButtonDown="OnSplashClick">
            <Viewbox x:Name="SplashBox" Stretch="Uniform" Width="420">
            <Canvas Width="360" Height="300">
                <Rectangle x:Name="Horizon" Canvas.Top="250" Width="360" Height="1" Fill="#4DFFFFFF" RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform><ScaleTransform x:Name="HorizonScale" ScaleX="0" /></Rectangle.RenderTransform>
                </Rectangle>
                <Viewbox x:Name="Ground" Canvas.Left="30" Canvas.Top="243" Width="300" Opacity="0">
                    <Canvas Width="300" Height="16">
                        <Path Data="M0,8 C40,1 260,1 300,8 C260,15 40,15 0,8 Z" Fill="#2F6B2A" />
                        <Path Data="M14,7 C60,2 240,2 286,7 C240,9 60,9 14,7 Z" Fill="#4E9A3C" />
                    </Canvas>
                </Viewbox>
                <Path x:Name="Tractor" Canvas.Left="120" Canvas.Top="62" Width="120" Height="188" Stretch="Fill"
                      Data="M38,0 L62,0 L100,100 L0,100 Z" Opacity="0" RenderTransformOrigin="0.5,0">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#80FF5A1F" Offset="0" />
                            <GradientStop Color="#00FF5A1F" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.RenderTransform><ScaleTransform x:Name="TractorScale" ScaleY="0" /></Path.RenderTransform>
                </Path>
                <Viewbox x:Name="Cow" Canvas.Left="65" Canvas.Top="116" Width="230" Opacity="0">
                    <Viewbox.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="CowGraze" CenterX="143" CenterY="134" />
                            <ScaleTransform x:Name="CowScale" CenterX="115" CenterY="68" />
                            <RotateTransform x:Name="CowSpin" CenterX="115" CenterY="68" />
                            <TranslateTransform x:Name="CowLift" />
                        </TransformGroup>
                    </Viewbox.RenderTransform>
                    <Canvas Width="965" Height="572">
                        <Canvas.RenderTransform><TranslateTransform X="-30" /></Canvas.RenderTransform>
