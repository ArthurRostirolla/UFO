<!-- Clip overlay: a small plate in a screen corner, over games. The saucer drops its beam on the caption
     when a clip is saved; a dot marks the corner while the replay buffer runs. Never takes focus or
     clicks, and is left out of the recording itself (see ClipOverlay.xaml.cs). -->
<Window x:Class="Ufo.ClipOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UFO clips" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{StaticResource TextFont}" Foreground="{DynamicResource InkBrush}" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
        <Border x:Name="Plate" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,10,16,10" Opacity="0">
            <Border.RenderTransform><TranslateTransform x:Name="PlateShift" /></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <Canvas Width="44" Height="36" Margin="0,0,12,0">
                    <Path Canvas.Top="18" Data="M17,0 H27 L34,17 H10 Z" Fill="{DynamicResource AccentBrush}">
                        <Path.RenderTransform><ScaleTransform x:Name="BeamScale" ScaleY="0" /></Path.RenderTransform>
                    </Path>
                    <ContentControl Style="{StaticResource UfoIcon}" Width="44" />
                </Canvas>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Medium" />
                    <TextBlock x:Name="MetaText" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
